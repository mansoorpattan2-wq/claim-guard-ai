# Backend variables are supplied by the process/container; Python does not auto-load this file.
APP_ENV=development
DEMO_MODE=true
# Backend: default is backend/claim guard.db (SQLite).
# DATABASE_URL=postgresql+psycopg://claimguard:<url-encoded-password>@127.0.0.1:15432/claimguard
# Frontend server proxy:
API_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# UPLOAD_DIR=/data/uploads
# Production requires PostgreSQL, explicit ALLOWED_ORIGINS and a secret reset key:
# DEMO_RESET_KEY=<generate-at-least-32-random-characters>
# Compose reads a separate ignored deploy.env:
# POSTGRES_PASSWORD=<generate-random-url-safe-password>
# DEMO_RESET_KEY=<generate-random-secret>
# API_URL is server-only and captured at frontend build time. No NEXT_PUBLIC_ database variables.
